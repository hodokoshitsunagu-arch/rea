    {
      "id": "com.dena.pokota.apk:resources.arsc:pool:12:string:2369",
      "offset": 175577,
      "text": "- After the %1$s day of the month, you can broadcast even if you did not set a Rest Day for the current month."
    },
    {
      "id": "com.dena.pokota.apk:resources.arsc:pool:12:string:2373",
      "offset": 175837,
      "text": "- You cannot broadcast on a Rest Day. \n- Your Rank will not change on a Rest Day. \n- You cannot use a Freeze Pass and Rest Day at the same time. \n- You can change a Rest Day’s settings until 10 minutes before it starts. \n- If a Rest Day starts while you are broadcasting, the broadcast will end automatically after a fixed amount of time."
    },
    {
      "id": "com.dena.pokota.apk:resources.arsc:pool:12:string:2805",
      "offset": 186464,
      "text": "Freezes your Rank Meter so you can take time off as needed."
    },
    {
      "id": "com.dena.pokota.apk:resources.arsc:pool:12:string:2871",
      "offset": 188147,
      "text": "It has been %1$s days since you last watched a broadcast. You will automatically be removed from the Family if you do not watch any broadcasts for 10 consecutive days."
    },
    {
      "id": "com.dena.pokota.apk:resources.arsc:pool:12:string:3092",
      "offset": 194718,
      "text": "Pococha asks broadcasters to take Rest Days. \nWe hope you can enjoy broadcasting by pacing yourself and taking time for self-care!"
    }
  ]
